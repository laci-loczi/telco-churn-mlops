# Copy to .env (`cp .env.example .env`). Never commit .env; it is git-ignored.
# Placeholder values: they only have to agree between this file and the stack,
# which reads them when its volumes are first created.

# ── Postgres (MLflow backend store) ───────────────────────────────────────────
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=mlflowdb

# ── Silo (S3-compatible object store) ─────────────────────────────────────────
# Named with the standard AWS_* names on purpose: DVC (via boto3) reads exactly
# these, so after `set -a && . ./.env && set +a` a plain `dvc push/pull` works.
# Compose passes the same values to Silo as its root user.
AWS_ACCESS_KEY_ID=s3_user
AWS_SECRET_ACCESS_KEY=change-me-s3
MLFLOW_BUCKET=mlflow-artifacts
DVC_BUCKET=dvc-storage

# ── Host ports: the 56xx block (the course labs use 55xx, so both can run) ───
MLFLOW_PORT=5600
S3_API_PORT=5610
S3_CONSOLE_PORT=5611
POSTGRES_HOST_PORT=5632

# ── MLflow client ─────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://127.0.0.1:5600
MLFLOW_EXPERIMENT_NAME=telco-churn
MLFLOW_REGISTERED_MODEL_NAME=telco-churn-classifier
MLFLOW_MODEL_ALIAS=staging
